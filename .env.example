# Optional local configuration. Copy to .env and supply your own values.
# Never commit .env. Main account setup is available through the desktop UI.
GEMINI_API_KEY=

# Midea Cloud (optional)
MIDEA_EMAIL=
MIDEA_PASSWORD=
MIDEA_DEVICE_NAME=
MIDEA_DRY_RUN=true

# Telegram remote control (optional; both values are required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
